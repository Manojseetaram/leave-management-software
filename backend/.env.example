DATABASE_URL=postgres://leave:leave@localhost:5432/leave_dev
BIND_ADDR=0.0.0.0:8080
# 64 hex chars (32 bytes). Generate with: openssl rand -hex 32   -- never commit the real one.
PHONE_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
SMS_PROVIDER=mock
SMS_MAX_ATTEMPTS=5
# Only used on the very first start (empty database). Admin must change it on first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Only enable when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
LOGIN_RATE_LIMIT_PER_MINUTE=10
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Development only: returns recovery tokens in the HTTP response. Never enable in production.
PASSWORD_RESET_EXPOSE_TOKEN=false
RUST_LOG=info,sqlx=warn
STORAGE_DIR=data/uploads
STORAGE_BACKEND=local
# S3 (only when STORAGE_BACKEND=s3)
# S3_BUCKET=your-bucket
# S3_PREFIX=leave-uploads
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
APP_BASE_URL=http://localhost:5173
EMAIL_PROVIDER=mock
# SMTP (only when EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=...
# SMTP_PASSWORD=...
# SMTP_FROM=no-reply@example.com
