# Base URL of the Rust/Axum backend API.
# Leave empty in development: the client falls back to the relative path
# "/api/v1", which Vite proxies to http://localhost:8080 (see vite.config.ts).
#
# In a production build set the absolute URL, for example:
# VITE_API_BASE_URL=https://leave-api.example.com/api/v1
VITE_API_BASE_URL=
